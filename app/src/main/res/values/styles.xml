<resources>
    <!-- Base app theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/dark_blue</item> <!-- Status bar color -->
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/white</item>
    </style>


    <style name="CustomButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="CustomSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/spinner_bg</item>
    </style>
    <style name="CircleImageViewStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item> <!-- 50% makes it circular -->
    </style>
    <style name="RoundedCardStyle" parent="Widget.MaterialComponents.CardView">
        <!-- Rounded/pill corners -->
        <item name="shapeAppearanceOverlay">@style/RoundedCardCorners</item>
        <!-- Use the card's own ripple so it follows the shape -->
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <style name="RoundedCardCorners">
        <item name="cornerFamily">rounded</item>
        <!-- Pick one: -->
        <!-- Pill-ish corners: -->
        <item name="cornerSize">24dp</item>
        <!-- OR true pill (height-based): -->
        <!-- <item name="cornerSize">50%</item> -->
    </style>
    <style name="RoundedCard" parent="Widget.MaterialComponents.CardView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50dp</item>
    </style>
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CircularImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item> <!-- smooth rounded corners -->
    </style>

</resources>
