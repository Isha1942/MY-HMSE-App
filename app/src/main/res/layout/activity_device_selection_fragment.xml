<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F9FAFB">

    <TextView
        android:id="@+id/tv_selected_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected Model"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/dark_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/deviceViewPager"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_selected_device"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/dotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/deviceViewPager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/inputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:elevation="4dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/dotsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/et_device_sim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Device SIM Number"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:inputType="number"
            android:maxLength="15"
            android:textColor="#212121"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter User Name"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:textColor="#212121"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_site_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Site Name"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:inputType="textCapWords"
            android:textColor="#212121"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_save_device"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Save"
        android:backgroundTint="@color/dark_blue"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:clipToOutline="true"
        android:stateListAnimator="@null"
        android:elevation="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/inputCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_saved_devices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Saved Devices"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/dark_blue"
        android:layout_marginBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/btn_save_device"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔍 Search box -->
    <EditText
        android:id="@+id/et_search_site"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:hint="Search by Site Name"
        android:background="@drawable/rounded_edittext"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:inputType="text"
        android:layout_marginBottom="6dp"
        android:textSize="14sp"
        android:textColor="#212121"
        android:textColorHint="#9E9E9E"
        app:layout_constraintTop_toBottomOf="@id/tv_saved_devices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_users_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/et_search_site"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>